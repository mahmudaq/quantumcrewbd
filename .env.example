# QuantumCrewBD — environment template
#
# Copy to `.env` for local development:  cp .env.example .env
#
# NEVER COMMIT `.env`. Values live in the team's KeePassXC vault under
# /QuantumCrewBD/ . In Streamlit Community Cloud, put the SAME variable names
# into the app's secrets UI — never in the repository.

# --- Supabase ---------------------------------------------------------------
# Project ref: qukqelcqngvlplayhjtp  (ap-northeast-2, PostgreSQL 17.11)
SUPABASE_URL=https://qukqelcqngvlplayhjtp.supabase.co

# The ANON / publishable key. Safe to ship to a browser because RLS enforces
# tenant isolation — but it is NOT an authorisation to read other tenants' data.
SUPABASE_ANON_KEY=

# DO NOT SET THIS IN THE APP. The service_role key BYPASSES row-level security
# entirely. It belongs only in a server-side migration/maintenance context,
# never in the Streamlit process, never in Cloud secrets, never in this repo.
# SUPABASE_SERVICE_ROLE_KEY=

# --- LLM --------------------------------------------------------------------
# CrewAI 1.x has no Groq provider and no litellm dependency (defect R-03), so we
# go through the generic OpenAI-compatible provider. Swapping vendors — e.g. to
# CommandCodeAI — is a change to these three values, not to any code.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL_NAME=openai/gpt-oss-120b

# --- Application ------------------------------------------------------------
# Query-string switch that enables verbose agent traces in the UI.
DEBUG_TRACES=false
