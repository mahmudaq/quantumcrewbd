# QuantumCrewBD — environment template
#
# Copy to `.env` for local development:  cp .env.example .env
#
# NEVER COMMIT `.env`. Values live in the team's KeePassXC vault under
# /QuantumCrewBD/ . In Streamlit Community Cloud, put the SAME variable names
# into the app's secrets UI — never in the repository.

# --- Supabase ---------------------------------------------------------------
# Project ref: qukqelcqngvlplayhjtp  (ap-northeast-2, PostgreSQL 17.11)
SUPABASE_URL=https://qukqelcqngvlplayhjtp.supabase.co

# The ANON / publishable key. Safe to ship to a browser because RLS enforces
# tenant isolation — but it is NOT an authorisation to read other tenants' data.
SUPABASE_ANON_KEY=

# DO NOT SET THIS IN THE APP. The service_role key BYPASSES row-level security
# entirely. It belongs only in a server-side migration/maintenance context,
# never in the Streamlit process, never in Cloud secrets, never in this repo.
# SUPABASE_SERVICE_ROLE_KEY=

# --- LLM --------------------------------------------------------------------
# Model choice is CONFIGURATION, not code. No agent hardcodes a model; every
# agent resolves its LLM through llm/registry.py, so switching providers or
# giving a single agent a different model is a change to these values only.
#
# Precedence (highest first) is documented in llm/registry.py::resolve():
#   per-call override > per-tenant DB setting > LLM_MODEL_<AGENT>
#   > LLM_MODEL > registry default


# --- Auth: bot protection ---------------------------------------------------
# Both are REQUIRED together. The site key is public (it ships to the browser);
# the secret must never leave the server — Supabase verifies the token with it.
# Leave unset to run without a CAPTCHA; sign-up forms then accept bots.
# Full setup: docs/AUTH-SETUP.md
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=
# Optional explicit switch. Setting the two keys above also enables it.
AUTH_CAPTCHA_ENABLED=

# Which provider: "commandcode" (default) or "groq" (fallback).
LLM_PROVIDER=commandcode

# Default model for every agent. Verified default as of 2026-10-03:
#   deepseek-v4.1-flash-fast  -- 1M ctx, tools OK, ~3.2s median on a full
#   23k-token tender, correct on pass-mark extraction 3/3 trials.
LLM_MODEL=deepseek-v4.1-flash-fast

# Per-agent override. Any KNOWN_AGENTS name, uppercased. Leave unset to use
# LLM_MODEL. Example -- send token-heavy extraction to the cheapest model and
# keep the expensive reasoner for the hard step:
#   LLM_MODEL_EXTRACTOR=gpt-6-luna
#   LLM_MODEL_WRITER=mimo-v2.6-pro

# API keys. Put the key for whichever provider LLM_PROVIDER names.
# Both endpoints are Cloudflare-fronted; the client injects a browser
# User-Agent automatically (see llm/client.py) -- nothing to configure.
# These are the DEPLOYMENT-WIDE fallback. A key saved on an account in the
# app's Configuration tab takes precedence, so the demo key can live on one
# account instead of on the host. Leave both blank to require per-account keys.
COMMANDCODE_API_KEY=
GROQ_API_KEY=

# --- Per-account key encryption ---------------------------------------------
# Encrypts each account's saved API key at rest (public.profiles.llm_api_key_enc).
# Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Also kept in KeePass as QuantumCrewBD/QC-Secret-Key.
# Losing it only makes already-saved keys undecryptable -- users re-enter them,
# so a missing value degrades gracefully rather than breaking the deployment.
QC_SECRET_KEY=

# --- Application ------------------------------------------------------------
# Query-string switch that enables verbose agent traces in the UI.
DEBUG_TRACES=false
